---
// Education & certificates ("Framed on the wall") and research & honours
// ("High scores"). Certificates are ordered AI first, then software/game dev,
// then other; the script shows the first five with a "Show all" button and
// an area filter. Without JS every frame is visible.
import p from '../../data/profile.json';

type Cert = (typeof p.certificationsAll)[number] & { note?: string };
const AREAS = [
  { id: 'ai', name: 'AI' },
  { id: 'software', name: 'Software & game dev' },
  { id: 'other', name: 'Other' },
];
const areaName = Object.fromEntries(AREAS.map((a) => [a.id, a.name]));
const rank = (a: string) => {
  const i = AREAS.findIndex((x) => x.id === a);
  return i < 0 ? AREAS.length : i;
};
const certs = (p.certificationsAll as Cert[])
  .map((c, i) => ({ ...c, i }))
  .sort((a, b) => rank(a.area) - rank(b.area) || a.i - b.i);
const SHOW = 5;
const areas = AREAS.filter((a) => certs.some((c) => c.area === a.id));

const research = p.research;
const nasa = p.certificationsAll.find((c) => c.org === 'NASA');
const life = p.projects.find((x) => x.id === 'project-life');
const steam = p.foundation.find((f) => f.title.startsWith('AlexanderBall'));
---
<section class="sec" id="credentials" aria-labelledby="cred-h">
  <div class="wrap">
    <div class="sec-head">
      <span class="kick">Framed on the wall · {p.education.length} degrees &amp; programmes · {certs.length} certificates</span>
      <h2 id="cred-h" tabindex="-1">Education, certificates &amp; research</h2>
    </div>

    <h3 class="certs-h" id="education" tabindex="-1">Education</h3>
    <ul class="certs edu">
      {p.education.map((e) => (
        <li class="cert"><div class="cert-in"><span class="kind">Education</span><h4>{e.title}</h4><p>{e.org}</p><p>{e.period}</p><span class="seal" aria-hidden="true"></span></div></li>
      ))}
    </ul>

    <h3 class="certs-h" id="certificates" tabindex="-1">Certificates · {certs.length}</h3>
    <div class="filters" role="group" aria-label="Filter certificates by area">
      <button type="button" aria-pressed="true" data-cfilter="all">All · {certs.length}</button>
      {areas.map((a) => (
        <button type="button" aria-pressed="false" data-cfilter={a.id} data-lid={`c-${a.id}`}>{a.name} · {certs.filter((c) => c.area === a.id).length}</button>
      ))}
    </div>
    <ul class="certs" data-certs data-show={SHOW}>
      {certs.map((c) => (
        <li class="cert" data-area={c.area}>
          <div class="cert-in">
            <span class="kind">{areaName[c.area] ?? c.area}</span>
            <h4>{c.title}</h4>
            <p>{c.org}</p>
            <p>{c.date}</p>
            {c.note && <p class="note-sm">{c.note}</p>}
            <span class="seal" aria-hidden="true"></span>
          </div>
        </li>
      ))}
    </ul>
    <div class="more-row">
      <button type="button" class="btn small" data-cert-more aria-expanded="false" hidden>Show all ({certs.length})</button>
      <p class="sr-only" aria-live="polite" data-cert-status></p>
    </div>

    <div class="scores" id="research">
      <h3>High scores · research &amp; honours</h3>
      <ol>
        <li>
          <span class="rank">PAPER</span>
          <div><b>IEEE CSDE {research.year} · {research.role}</b>
            <p>{research.title}. {research.venue}. <a href={research.url} target="_blank" rel="noopener">DOI ↗</a></p></div>
        </li>
        {nasa && (
          <li>
            <span class="rank">HACK</span>
            <div><b>{nasa.title} · {nasa.date}</b>{life && <p>{life.title}: {life.summary.split(';')[0]}, with {life.org}.</p>}</div>
          </li>
        )}
        {steam && (
          <li>
            <span class="rank">GAME</span>
            <div><b>Steam · {steam.fact.replace(' on Steam', '')}</b><p>{steam.title}, {steam.org}. I architected and shipped it as lead developer.</p></div>
          </li>
        )}
      </ol>
    </div>
  </div>
</section>
